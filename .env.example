# Development-only placeholder. Always replace this with a strong, unique value.
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=recruitment-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# The defaults below keep local HTTP development convenient. Enable the secure
# settings when deploying behind HTTPS (as CI does for `check --deploy`).
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
# Enable only when TLS is terminated by a trusted reverse proxy.
TRUST_PROXY_SSL_HEADER=false
LOG_LEVEL=INFO
